# Get an API Read Access Token from https://www.themoviedb.org/settings/api
# Keep this on your server; never put it in frontend code.
TMDB_READ_ACCESS_TOKEN=
# Alternatively: TMDB_API_KEY=
TMDB_API_KEY=
# Publicly documented external iframe integration. Only use content you are authorized to distribute.
ENABLE_VIDY=true
# Backend port. Vite development frontend uses 5173.
PORT=3001
