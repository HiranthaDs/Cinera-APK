{
  "name": "cinera-streaming-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/catalog.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "hls.js": "^1.5.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
