{
  "name": "cinera-streaming-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "check": "node --check worker/index.js && node --check worker/catalog.js && node --check worker/seed.js && node --check worker/sources.js",
    "test": "node --test",
    "validate": "npm run check && npm test && npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "hls.js": "^1.5.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "wrangler": "^4.156.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
